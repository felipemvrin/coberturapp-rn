{
  "expo": {
    "name": "CoberturApp",
    "slug": "coberturapp-rn",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "coberturapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cl.coberturapp.app"
    },
    "android": {
      "package": "cl.coberturapp.app",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CoberturApp usa tu ubicación para calcular la distancia y dirección hacia las antenas cercanas."
        }
      ]
    ]
  }
}
